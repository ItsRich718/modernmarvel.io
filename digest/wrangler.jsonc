{
  // Modern Marvel: the AI Digest, served from modernmarvel.io/ai-digest*
  //
  // This is an assets-only Worker. There is no server code: Cloudflare serves
  // the files in ./public directly. Nothing here runs JavaScript at request time.
  //
  // The worker name changed from "modernmavel-io" to "modernmarvel-io" when the
  // corrected domain was acquired on 2026-08-20. Workers cannot be renamed in
  // place, so this deploy CREATES a new worker. The old one is deleted by hand
  // at the end, after the new one is confirmed serving. See HOW-TO-PUBLISH.md.

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modernmarvel-io",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./public",
    // Serves public/404.html for any path that does not match a file.
    "not_found_handling": "404-page"
  },

  // BOTH entries below already exist in Cloudflare. They are declared here
  // because Wrangler treats this file as the source of truth for routing and
  // will reconcile the account to match it on every deploy. An entry that is
  // live but missing from this list can be removed by a routine deploy.
  //
  // The custom_domain entry is load-bearing for the WHOLE SITE. A Custom
  // Domain owns the DNS record for modernmarvel.io. Delete it and the apex
  // stops resolving, which also strands the modernmarvel-home Worker, whose
  // route has no DNS record left to attach to. Removing this line takes down
  // the landing page as well as the digest.
  //
  // Because this Worker holds the apex hostname, it answers every path that no
  // more specific route claims -- that is why an unknown URL such as
  // modernmarvel.io/nonsense returns this Worker's public/404.html rather than
  // anything belonging to modernmarvel-home.
  //
  // Do NOT widen the route pattern to modernmarvel.io/*: that would out-specify
  // the modernmarvel-home route on "modernmarvel.io/" and take the landing page
  // dark.
  "routes": [
    {
      "pattern": "modernmarvel.io",
      "custom_domain": true
    },
    {
      "pattern": "modernmarvel.io/ai-digest*",
      "zone_name": "modernmarvel.io"
    }
  ]
}
